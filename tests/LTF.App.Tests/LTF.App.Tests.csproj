<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Headless Avalonia: drives the real App/windows on Linux CI + Win/macOS matrix, no display. -->
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LTF.App\LTF.App.csproj" />
  </ItemGroup>

  <!-- Copy both carsets so the session loader and the carset catalog can be tested against real content. -->
  <ItemGroup>
    <None Include="..\..\content\carsets\global-prix\carset.json" Link="carsets/global-prix.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\carsets\global-prix-2026\carset.json" Link="carsets/global-prix-2026.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
