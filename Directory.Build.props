<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NOTE: Do NOT set InvariantGlobalization=true globally. In the WPF app it makes
      the first TextBox throw CultureNotFoundException while resolving its "en-US"
      culture, crashing the New Career screen. The engine already parses/formats with
      an explicit CultureInfo.InvariantCulture, so it does not need the global switch.
    -->
  </PropertyGroup>
</Project>
