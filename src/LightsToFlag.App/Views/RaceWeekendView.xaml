<UserControl x:Class="LightsToFlag.App.Views.RaceWeekendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource TrackBlackBrush}">
        <Grid Margin="40" MaxWidth="1040" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding CircuitName}" Style="{StaticResource DisplayText}" />
                <TextBlock Text="{Binding RoundLabel}" Style="{StaticResource MutedText}" />
            </StackPanel>

            <!-- PRACTICE -->
            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                    Visibility="{Binding Stage, Converter={StaticResource StrEqVis}, ConverterParameter=practice}">
                <StackPanel>
                    <TextBlock Text="PRACTICE" Style="{StaticResource H1Text}" Margin="0,0,0,8" />
                    <TextBlock Text="More laps dial in a better setup — up to your car and feedback ceiling."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <TextBlock Text="PRACTICE LAPS" Style="{StaticResource LabelText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                        <Slider Minimum="0" Maximum="60" Value="{Binding PracticeLaps}" Width="320" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PracticeLaps}" Style="{StaticResource NumericText}" FontSize="20" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="RUN PRACTICE" Style="{StaticResource PrimaryButton}" Command="{Binding RunPracticeCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- QUALIFYING -->
            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                    Visibility="{Binding Stage, Converter={StaticResource StrEqVis}, ConverterParameter=qualifying}">
                <StackPanel>
                    <TextBlock Text="QUALIFYING" Style="{StaticResource H1Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PracticeResult}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <Button Content="RUN QUALIFYING" Style="{StaticResource PrimaryButton}" Command="{Binding RunQualifyingCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding QualifyingResult}" Style="{StaticResource NumericText}" FontSize="16"
                               Visibility="{Binding QualifyingDone, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding QualifyingDone, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="START TYRE" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding TyreChoices}" SelectedItem="{Binding StartingTyre}" Width="140"
                                  Foreground="Black" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="START RACE" Style="{StaticResource PrimaryButton}" Command="{Binding StartRaceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RACE (live timing) -->
            <Grid Grid.Row="1" Visibility="{Binding Stage, Converter={StaticResource StrEqVis}, ConverterParameter=race}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LAP" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentLap}" Style="{StaticResource NumericText}" FontSize="26" Margin="8,0,4,0" />
                            <TextBlock Text="/" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalLaps}" Style="{StaticResource MutedText}" FontSize="16" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SPEED" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Minimum="0.5" Maximum="4" Value="{Binding Speed}" Width="120" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="NEXT LAP" Style="{StaticResource PrimaryButton}" Command="{Binding NextLapCommand}" Margin="0,0,10,0" />
                            <Button Content="PLAY / PAUSE" Style="{StaticResource GhostButton}" Command="{Binding TogglePlayCommand}" Margin="0,0,10,0" />
                            <Button Content="SKIP" Style="{StaticResource GhostButton}" Command="{Binding SkipToEndCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Live timing -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DataGrid ItemsSource="{Binding Live}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                            <Setter Property="Background" Value="#22FF3B2F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="POS" Binding="{Binding Position}" Width="55" />
                                <DataGridTemplateColumn Header="TYRE" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                                     Fill="{Binding Tyre, Converter={StaticResource TyreBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="DRIVER" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="GAP" Binding="{Binding Gap}" Width="110" />
                                <DataGridTextColumn Header="" Binding="{Binding Status}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Commentary feed -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="COMMENTARY" Style="{StaticResource LabelText}" Margin="4,0,0,10" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Commentary}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource GarageHiBrush}" CornerRadius="4"
                                                        Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Lap}" FontFamily="{StaticResource FontNumeric}"
                                                               FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- RESULTS -->
            <Grid Grid.Row="1" Visibility="{Binding Stage, Converter={StaticResource StrEqVis}, ConverterParameter=results}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding WinnerText}" Style="{StaticResource H1Text}"
                           Foreground="{StaticResource RedBrush}" Margin="0,0,0,14" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                    <DataGrid ItemsSource="{Binding Results}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                        <Setter Property="Background" Value="#22FF3B2F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="POS" Binding="{Binding Position}" Width="55" />
                            <DataGridTextColumn Header="DRIVER" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="TEAM" Binding="{Binding Team}" Width="*" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="PTS" Binding="{Binding Points, StringFormat=0}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Button Grid.Row="2" Content="BACK TO CAREER" Style="{StaticResource PrimaryButton}"
                        Command="{Binding BackToCareerCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
