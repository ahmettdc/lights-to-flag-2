<UserControl x:Class="LightsToFlag.App.Views.LoadGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource TrackBlackBrush}">
        <Border Style="{StaticResource Card}" Width="460" MaxHeight="520"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LOAD GAME" Style="{StaticResource H1Text}" Margin="0,0,0,16" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="BACK" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" Margin="0,0,12,0" />
                    <Button Content="LOAD" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource RedBrush}"
                               VerticalAlignment="Center" Margin="16,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="No saved careers yet." Style="{StaticResource MutedText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" MinHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="16" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
