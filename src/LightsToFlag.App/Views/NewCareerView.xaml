<UserControl x:Class="LightsToFlag.App.Views.NewCareerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource TrackBlackBrush}">
        <Grid Margin="48" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="NEW CAREER" Style="{StaticResource DisplayText}" Margin="0,0,0,20" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CARSET" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <ListBox ItemsSource="{Binding Carsets}" SelectedItem="{Binding SelectedCarset}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="16" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CHOOSE YOUR DRIVER" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <ListBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" />
                                            <TextBlock Text="{Binding Nationality}" Style="{StaticResource MutedText}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Team}" VerticalAlignment="Center"
                                                   Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                <Button Content="BACK" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" Margin="0,0,12,0" />
                <TextBlock Text="SEED" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Text="{Binding Seed}" Width="90" VerticalContentAlignment="Center" Padding="8,6"
                         Background="{StaticResource GarageHiBrush}" Foreground="{StaticResource WhiteBrush}"
                         BorderBrush="{StaticResource LineBrush}" FontFamily="{StaticResource FontNumeric}" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"
                           Margin="16,0" TextWrapping="Wrap" MaxWidth="360" />
                <Button Content="START CAREER" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                        HorizontalAlignment="Right" Margin="16,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
