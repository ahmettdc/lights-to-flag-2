<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Embedded brand fonts (Google Fonts, OFL). Weight is chosen via FontWeight. -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Saira Condensed</FontFamily>
    <FontFamily x:Key="FontNumeric">pack://application:,,,/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#Archivo</FontFamily>

</ResourceDictionary>
