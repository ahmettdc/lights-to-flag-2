<Application x:Class="LightsToFlag.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LightsToFlag.App.Converters"
             xmlns:vm="clr-namespace:LightsToFlag.App.ViewModels"
             xmlns:views="clr-namespace:LightsToFlag.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Fonts.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:StringEqualsToVisibilityConverter x:Key="StrEqVis" />
            <conv:StringEqualsToBoolConverter x:Key="StrEqBool" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:TyreBrushConverter x:Key="TyreBrush" />

            <!-- View-model → view mapping -->
            <DataTemplate DataType="{x:Type vm:MainMenuViewModel}"><views:MainMenuView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewCareerViewModel}"><views:NewCareerView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoadGameViewModel}"><views:LoadGameView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CareerViewModel}"><views:CareerView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RaceWeekendViewModel}"><views:RaceWeekendView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
