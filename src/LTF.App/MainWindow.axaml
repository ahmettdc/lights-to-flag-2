<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:LTF.App.Views"
        x:Class="LTF.App.MainWindow"
        Title="Lights to Flag 2"
        Icon="/Assets/Branding/icon-512.png"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushAppBackground}">

  <!-- The application root: lands on the main menu, swaps to the shell on entering a career (M20).
       DataContext (a RootViewModel) is set by App at startup. -->
  <v:RootView />

</Window>
