<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:LTF.App.Shell"
        x:Class="LTF.App.MainWindow"
        Title="Lights to Flag 2"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushAppBackground}">

  <!-- The permanent navigation shell. DataContext (a ShellViewModel) is set by App at startup. -->
  <shell:ShellView />

</Window>
