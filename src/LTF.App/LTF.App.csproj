<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Developer tooling only in Debug builds. -->
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTF.Career\LTF.Career.csproj" />
    <ProjectReference Include="..\LTF.Persistence\LTF.Persistence.csproj" />
    <ProjectReference Include="..\LTF.Content\LTF.Content.csproj" />
  </ItemGroup>

  <!-- Embed the brand fonts (OFL). The .ttf files are addressed via avares:// in Theme/Typography.axaml. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>

  <!-- Embed the brand logo/icon kit (from design/brand/). icon-512.png is the window icon; the logos
       are addressed via avares:// (the main menu uses them in M20). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Branding/*.png" />
  </ItemGroup>

  <!-- Carsets copied next to the app: the flagship shown in M19's top bar, plus the 2026 "Active Aero
       Era" set. The main-menu carset catalog (M20) discovers every carsets/*.json here. -->
  <ItemGroup>
    <None Include="..\..\content\carsets\global-prix\carset.json" Link="carsets/global-prix.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\carsets\global-prix-2026\carset.json" Link="carsets/global-prix-2026.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
