<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:screens="using:LTF.App.ViewModels.Screens"
             xmlns:views="using:LTF.App.Views.Screens"
             xmlns:vm="using:LTF.App.ViewModels"
             xmlns:menuvm="using:LTF.App.ViewModels.Menu"
             xmlns:menuviews="using:LTF.App.Views.Menu"
             xmlns:setvm="using:LTF.App.ViewModels.Settings"
             xmlns:setviews="using:LTF.App.Views.Settings"
             xmlns:quickvm="using:LTF.App.ViewModels.Quick"
             xmlns:quickviews="using:LTF.App.Views.Quick"
             xmlns:shell="using:LTF.App.Shell"
             xmlns:conv="using:LTF.App.Converters"
             x:Class="LTF.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <!-- Top-level view-model -> view. The application root (RootViewModel) swaps between these; the shell's
         content region still resolves placeholder screens (real in-shell screens register in M21/M22). -->
    <DataTemplate DataType="{x:Type menuvm:MainMenuViewModel}">
      <menuviews:MainMenuView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type menuvm:NewCareerViewModel}">
      <menuviews:NewCareerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type menuvm:LoadGameViewModel}">
      <menuviews:LoadGameView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type setvm:SettingsViewModel}">
      <setviews:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type quickvm:QuickRaceViewModel}">
      <quickviews:QuickRaceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShellViewModel}">
      <shell:ShellView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:PlaceholderScreenViewModel}">
      <views:PlaceholderScreenView />
    </DataTemplate>
    <!-- In-shell career screens (M21), resolved in the shell's content region. -->
    <DataTemplate DataType="{x:Type screens:StandingsViewModel}">
      <views:StandingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:CalendarViewModel}">
      <views:CalendarView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:DriversViewModel}">
      <views:DriversView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:DatabaseViewModel}">
      <views:DatabaseView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:EntityDetailViewModel}">
      <views:EntityDetailView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:PaddockHubViewModel}">
      <views:PaddockHubView />
    </DataTemplate>
    <!-- Management screens (M22). -->
    <DataTemplate DataType="{x:Type screens:FinanceViewModel}">
      <views:FinanceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:RndFacilitiesViewModel}">
      <views:RndFacilitiesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:CarsPowerUnitViewModel}">
      <views:CarsPowerUnitView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:BoardSponsorsViewModel}">
      <views:BoardSponsorsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type screens:StaffViewModel}">
      <views:StaffView />
    </DataTemplate>
    <!-- Race weekend (M23): live timing tower replaying the round's recorded telemetry. -->
    <DataTemplate DataType="{x:Type screens:RaceWeekendViewModel}">
      <views:RaceWeekendView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Colours before Brushes: brushes reference colour keys. -->
        <ResourceInclude Source="avares://LTF.App/Theme/Colors.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Brushes.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Typography.axaml" />
        <!-- Design-system control themes (reference brushes via DynamicResource). -->
        <ResourceInclude Source="avares://LTF.App/Theme/Controls/Card.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Controls/Badge.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Controls/ProgressBar.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Controls/Tooltip.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Controls/States.axaml" />
        <ResourceInclude Source="avares://LTF.App/Theme/Controls/Dialog.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Shared converters. -->
      <conv:StatusColorConverter x:Key="StatusColor" />
      <conv:SeverityColorConverter x:Key="SeverityColor" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Brand theme layers on top of Fluent; Fluent must come first. -->
    <FluentTheme />
    <StyleInclude Source="avares://LTF.App/Theme/Controls/Button.axaml" />
    <StyleInclude Source="avares://LTF.App/Theme/Controls/NavItem.axaml" />
  </Application.Styles>

</Application>
