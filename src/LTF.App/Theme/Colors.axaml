<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Brand palette + extended ramp. Single source of truth for every colour in the app.
    Values are the locked brand kit (design/brand/README.txt) and the mockup's CSS
    (design/mockups/ui.dc.html). The app is Dark-only, so these are flat (no theme variants).
  -->

  <!-- Brand core -->
  <Color x:Key="ColorTrackBlack">#08090B</Color>
  <Color x:Key="ColorGarage">#14171C</Color>
  <Color x:Key="ColorLightsOutRed">#FF3B2F</Color>
  <Color x:Key="ColorFlagWhite">#F2F4F6</Color>

  <!-- Surface ramp (chrome bars, cards, cells) -->
  <Color x:Key="ColorChrome">#0B0D10</Color>
  <Color x:Key="ColorStatCell">#0F1216</Color>
  <Color x:Key="ColorDivider">#1C1F24</Color>
  <Color x:Key="ColorCardBorder">#22262C</Color>
  <Color x:Key="ColorBorderStrong">#2B3038</Color>

  <!-- Text ramp -->
  <Color x:Key="ColorTextPrimary">#F2F4F6</Color>
  <Color x:Key="ColorTextSecondary">#C6CBD1</Color>
  <Color x:Key="ColorTextMuted">#9AA0A8</Color>
  <Color x:Key="ColorTextDim">#5C6169</Color>
  <Color x:Key="ColorTextFaint">#3F444B</Color>

  <!-- Status (>= 80 good / >= 70 warn / else bad — mirrors StatusColorConverter) -->
  <Color x:Key="ColorStatusGood">#35D07F</Color>
  <Color x:Key="ColorStatusWarn">#FFB020</Color>
  <Color x:Key="ColorStatusBad">#FF3B2F</Color>

  <!-- Red variants + lights -->
  <Color x:Key="ColorButtonHover">#FF5647</Color>
  <Color x:Key="ColorTextOnRed">#0A0B0E</Color>
  <Color x:Key="ColorLightLit">#FF2D1E</Color>
  <Color x:Key="ColorLightOut">#33201D</Color>

  <!-- Data / category palette (team colours, charts, standings bars) -->
  <Color x:Key="ColorDataGold">#E8B33A</Color>
  <Color x:Key="ColorDataBlue">#3B82F6</Color>
  <Color x:Key="ColorDataPurple">#8B5CF6</Color>
  <Color x:Key="ColorDataOrange">#F97316</Color>
  <Color x:Key="ColorDataTeal">#14B8A6</Color>
  <Color x:Key="ColorDataPink">#EC4899</Color>

</ResourceDictionary>
