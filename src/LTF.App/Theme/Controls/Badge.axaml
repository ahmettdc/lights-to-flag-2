<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:LTF.App.Controls">

  <ControlTheme x:Key="{x:Type c:Badge}" TargetType="c:Badge">
    <Setter Property="Background" Value="{DynamicResource BrushStatCell}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding Text}"
                     Foreground="{TemplateBinding Foreground}"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Tone tints -->
    <Style Selector="^[Tone=Accent]">
      <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextOnRed}" />
    </Style>
    <Style Selector="^[Tone=Good]">
      <Setter Property="Background" Value="{DynamicResource BrushStatusGood}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextOnRed}" />
    </Style>
    <Style Selector="^[Tone=Warn]">
      <Setter Property="Background" Value="{DynamicResource BrushStatusWarn}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextOnRed}" />
    </Style>
    <Style Selector="^[Tone=Bad]">
      <Setter Property="Background" Value="{DynamicResource BrushStatusBad}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextOnRed}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
