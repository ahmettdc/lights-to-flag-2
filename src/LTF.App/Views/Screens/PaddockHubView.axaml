<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:screens="using:LTF.App.ViewModels.Screens"
             xmlns:loc="using:LTF.App.Localization"
             x:Class="LTF.App.Views.Screens.PaddockHubView"
             x:DataType="screens:PaddockHubViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.cardHeader">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BrushDivider}" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource BrushAppBackground}" LastChildFill="True">

    <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource BrushChrome}"
            BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Tr nav.paddockHub}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontNumeric}" FontSize="11" FontWeight="Bold" LetterSpacing="2"
                   Foreground="{DynamicResource BrushTextPrimary}" />
        <TextBlock Grid.Column="1" Text="{Binding TeamName}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontNumeric}" FontSize="10" LetterSpacing="1.2"
                   Foreground="{DynamicResource BrushTextDim}" />
      </Grid>
    </Border>

    <Grid Margin="12" ColumnDefinitions="272,*,*">

      <!-- Summary status -->
      <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource BrushStatCell}"
              BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Classes="cardHeader" Text="{loc:Tr paddock.summaryStatus}" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="10">

              <Border CornerRadius="5" Padding="11,9" Background="{DynamicResource BrushCard}"
                      BorderBrush="{DynamicResource BrushStatusBad}" BorderThickness="3,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding CriticalCount}" VerticalAlignment="Center"
                             FontFamily="{DynamicResource FontNumeric}" FontSize="20" FontWeight="Bold"
                             Foreground="{DynamicResource BrushStatusBad}" />
                  <TextBlock Text="{loc:Tr paddock.criticalDecisions}" VerticalAlignment="Center"
                             FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                </StackPanel>
              </Border>
              <Border CornerRadius="5" Padding="11,9" Background="{DynamicResource BrushCard}"
                      BorderBrush="{DynamicResource BrushStatusWarn}" BorderThickness="3,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding WarningCount}" VerticalAlignment="Center"
                             FontFamily="{DynamicResource FontNumeric}" FontSize="20" FontWeight="Bold"
                             Foreground="{DynamicResource BrushStatusWarn}" />
                  <TextBlock Text="{loc:Tr paddock.highPriority}" VerticalAlignment="Center"
                             FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                </StackPanel>
              </Border>
              <Border CornerRadius="5" Padding="11,9" Background="{DynamicResource BrushCard}"
                      BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="3,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding PendingCount}" VerticalAlignment="Center"
                             FontFamily="{DynamicResource FontNumeric}" FontSize="20" FontWeight="Bold"
                             Foreground="{DynamicResource BrushTextMuted}" />
                  <TextBlock Text="{loc:Tr paddock.pendingItems}" VerticalAlignment="Center"
                             FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
              </Border>

              <Border Classes="divider" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="statLabel" Text="{loc:Tr paddock.wccPosition}" />
                <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding WccText}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="statLabel" Text="{loc:Tr top.capRoom}" />
                <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding CapRoomText}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="statLabel" Text="{loc:Tr paddock.boardConfidence}" />
                <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding BoardConfidenceText}"
                           Foreground="{Binding BoardBrush}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="statLabel" Text="{loc:Tr paddock.nextSession}" />
                <TextBlock Grid.Column="1" Classes="statValue" Text="{Binding NextSessionText}" />
              </Grid>

              <Border Classes="divider" />

              <TextBlock Classes="sectionLabel" Text="{loc:Tr paddock.nextEvent}" />
              <TextBlock Text="{Binding NextEventName}" FontFamily="{DynamicResource FontHeading}" FontSize="22"
                         Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding NextEventSubtitle}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
              <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Margin="0,2,0,0" IsVisible="{Binding HasNextRace}"
                      Command="{Binding GoToRaceWeekendCommand}" Content="{loc:Tr paddock.goToRaceWeekend}" />

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Current events (inbox snippet) -->
      <Border Grid.Column="1" Margin="6,0,6,0" Background="{DynamicResource BrushStatCell}"
              BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardHeader" Text="{loc:Tr paddock.currentEvents}" />
              <TextBlock Grid.Column="1" Classes="cardHeader" Foreground="{DynamicResource BrushTextDim}"
                         Text="{Binding InboxCountText}" />
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="screens:PaddockEventViewModel">
                  <Border BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="12,11">
                    <Grid ColumnDefinitions="Auto,*">
                      <Ellipse Width="6" Height="6" Margin="0,5,11,0" VerticalAlignment="Top" Fill="{Binding DotBrush}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontNumeric}" FontSize="11"
                                     FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource BrushTextPrimary}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Category}" FontFamily="{DynamicResource FontNumeric}" FontSize="9"
                                     LetterSpacing="1.2" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextDim}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Paddock dialogue (empty state until M22/M23) -->
      <Border Grid.Column="2" Margin="6,0,0,0" Background="{DynamicResource BrushStatCell}"
              BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Classes="cardHeader" Text="{loc:Tr paddock.dialogue}" />
          </Border>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="24">
            <TextBlock Text="{loc:Tr paddock.dialogueEmpty}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontHeading}" FontSize="18"
                       Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{loc:Tr paddock.dialogueEmptyBody}" HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" MaxWidth="240" />
          </StackPanel>
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>

</UserControl>
