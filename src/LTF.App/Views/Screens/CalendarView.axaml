<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:screens="using:LTF.App.ViewModels.Screens"
             xmlns:loc="using:LTF.App.Localization"
             x:Class="LTF.App.Views.Screens.CalendarView"
             x:DataType="screens:CalendarViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.cardHeader">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource BrushAppBackground}" LastChildFill="True">

    <!-- Screen header strip -->
    <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource BrushChrome}"
            BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Tr nav.calendar}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontNumeric}" FontSize="11" FontWeight="Bold" LetterSpacing="2"
                   Foreground="{DynamicResource BrushTextPrimary}" />
        <TextBlock Grid.Column="1" Text="{Binding SeasonLabel}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontNumeric}" FontSize="10" LetterSpacing="1.2"
                   Foreground="{DynamicResource BrushTextDim}" />
      </Grid>
    </Border>

    <Grid Margin="12" ColumnDefinitions="*,*">

      <!-- Fixture list -->
      <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource BrushStatCell}"
              BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Classes="cardHeader" Text="{loc:Tr calendar.fixture}" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rounds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="screens:CalendarRoundRowViewModel">
                  <Grid Height="26" ColumnDefinitions="36,*,Auto,52" Margin="14,0" Background="Transparent">
                    <TextBlock Grid.Column="0" Text="{Binding RoundLabel}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="10" LetterSpacing="1"
                               Foreground="{Binding StatusBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Circuit}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="11" FontWeight="SemiBold" LetterSpacing="1"
                               Foreground="{Binding CircuitBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="10"
                               Foreground="{DynamicResource BrushTextDim}" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" VerticalAlignment="Center" TextAlignment="Right"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                               Foreground="{Binding StatusBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Next race profile -->
      <Border Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource BrushStatCell}"
              BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardHeader" Text="{Binding NextRaceHeading}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding NextRaceSubtitle}" Classes="cardHeader"
                         Foreground="{DynamicResource BrushTextDim}" />
            </Grid>
          </Border>
          <StackPanel Margin="14" Spacing="12">
            <TextBlock Classes="sectionLabel" Text="{loc:Tr calendar.trackProfile}" IsVisible="{Binding HasNextRace}" />
            <ItemsControl ItemsSource="{Binding Profile}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="screens:ProfileStatViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,20,9">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="12"
                               Foreground="{DynamicResource BrushTextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="12"
                               Foreground="{Binding ValueBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>

</UserControl>
