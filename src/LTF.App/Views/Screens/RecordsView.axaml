<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:screens="using:LTF.App.ViewModels.Screens"
             xmlns:loc="using:LTF.App.Localization"
             x:Class="LTF.App.Views.Screens.RecordsView"
             x:DataType="screens:RecordsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.colHead">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BrushStatCell}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource BrushAppBackground}" LastChildFill="True">

    <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource BrushChrome}"
            BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1" Padding="14,0">
      <TextBlock Text="{loc:Tr nav.records}" VerticalAlignment="Center"
                 FontFamily="{DynamicResource FontNumeric}" FontSize="11" FontWeight="Bold" LetterSpacing="2"
                 Foreground="{DynamicResource BrushTextPrimary}" />
    </Border>

    <TabControl Margin="12,8,12,12">

      <!-- Career profiles (M24d): every driver's accumulated record + the selected profile card. -->
      <TabItem Header="{loc:Tr records.tabProfiles}">
        <Grid Margin="0,10,0,0" ColumnDefinitions="1.5*,*">

          <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Top" Background="{DynamicResource BrushChrome}"
                      BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid ColumnDefinitions="28,*,52,48,44,44,52,56">
                  <TextBlock Grid.Column="0" Classes="colHead" Text="#" />
                  <TextBlock Grid.Column="1" Classes="colHead" Text="{loc:Tr records.colDriver}" Margin="9,0,0,0" />
                  <TextBlock Grid.Column="2" Classes="colHead" Text="{loc:Tr records.colRaces}" TextAlignment="Center" />
                  <TextBlock Grid.Column="3" Classes="colHead" Text="{loc:Tr records.colWins}" TextAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes="colHead" Text="{loc:Tr records.colPodiums}" TextAlignment="Center" />
                  <TextBlock Grid.Column="5" Classes="colHead" Text="{loc:Tr records.colPoles}" TextAlignment="Center" />
                  <TextBlock Grid.Column="6" Classes="colHead" Text="{loc:Tr records.colTitles}" TextAlignment="Center" />
                  <TextBlock Grid.Column="7" Classes="colHead" Text="{loc:Tr records.colPoints}" TextAlignment="Center" />
                </Grid>
              </Border>
              <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                       Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="screens:CareerProfileRowViewModel">
                    <Grid ColumnDefinitions="28,*,52,48,44,44,52,56" Height="32">
                      <TextBlock Grid.Column="0" Text="{Binding Rank}" Classes="num"
                                 Foreground="{DynamicResource BrushTextDim}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" Margin="9,0,0,0"
                                  VerticalAlignment="Center">
                        <Border Width="3" Height="15" Background="{Binding Accent}" />
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Races}" Classes="num" />
                      <TextBlock Grid.Column="3" Text="{Binding Wins}" Classes="num"
                                 FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                      <TextBlock Grid.Column="4" Text="{Binding Podiums}" Classes="num" />
                      <TextBlock Grid.Column="5" Text="{Binding Poles}" Classes="num" />
                      <TextBlock Grid.Column="6" Text="{Binding Titles}" Classes="num"
                                 Foreground="{DynamicResource BrushAccent}" />
                      <TextBlock Grid.Column="7" Text="{Binding Points}" Classes="num"
                                 FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Classes="card" Margin="6,0,0,0">
            <DockPanel LastChildFill="True">
              <!-- Career trend (M24g): the selected driver's points by season, hidden with fewer than two. -->
              <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasCareerTrend}"
                      BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                <StackPanel Spacing="6">
                  <TextBlock Classes="colHead" Text="{loc:Tr records.careerTrend}" />
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <Canvas Width="300" Height="96" Background="Transparent">
                      <Line StartPoint="12,84" EndPoint="288,84"
                            Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" />
                      <Line StartPoint="12,12" EndPoint="12,84"
                            Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" />
                      <Path Data="{Binding CareerTrend.LineData}" Stroke="{Binding CareerTrend.Stroke}"
                            StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </StackPanel>
              </Border>
              <ContentControl Content="{Binding ProfileDetail}" />
            </DockPanel>
          </Border>

        </Grid>
      </TabItem>

      <!-- This season (M24f): stat leaders + teammate head-to-head + points-progression chart. -->
      <TabItem Header="{loc:Tr records.tabThisSeason}">
        <Panel Margin="0,10,0,0">
          <TextBlock Text="{loc:Tr records.emptySeason}" IsVisible="{Binding !HasSeason}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="12" Foreground="{DynamicResource BrushTextDim}" />

          <Grid IsVisible="{Binding HasSeason}" RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">

              <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
                <StackPanel>
                  <Border Background="{DynamicResource BrushChrome}" BorderBrush="{DynamicResource BrushCardBorder}"
                          BorderThickness="0,0,0,1" Padding="12,7">
                    <TextBlock Classes="colHead" Text="{loc:Tr records.seasonLeaders}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding SeasonLeaders}" Margin="0,4,0,6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="screens:SeasonLeaderViewModel">
                        <Grid ColumnDefinitions="*,*,Auto" Height="26" Margin="12,0">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                     FontFamily="{DynamicResource FontNumeric}" FontSize="11"
                                     Foreground="{DynamicResource BrushTextMuted}" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Width="3" Height="13" Background="{Binding Accent}" />
                            <TextBlock Text="{Binding Driver}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="num" FontWeight="Bold"
                                     Foreground="{DynamicResource BrushAccent}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Margin="6,0,0,0" IsVisible="{Binding HasHeadToHead}">
                <StackPanel>
                  <Border Background="{DynamicResource BrushChrome}" BorderBrush="{DynamicResource BrushCardBorder}"
                          BorderThickness="0,0,0,1" Padding="12,7">
                    <TextBlock Classes="colHead" Text="{loc:Tr records.headToHead}" />
                  </Border>
                  <StackPanel Margin="12,8" Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Border Width="3" Height="13" Background="{Binding HeadToHead.AccentA}" />
                        <TextBlock Text="{Binding HeadToHead.DriverA}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding HeadToHead.DriverB}" FontSize="12"
                                 Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"
                                 TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="*,40,14,40">
                      <TextBlock Grid.Column="0" Text="{loc:Tr records.hthQualifying}" Classes="colHead" />
                      <TextBlock Grid.Column="1" Text="{Binding HeadToHead.QualifyingA}" Classes="num" FontWeight="Bold" />
                      <TextBlock Grid.Column="2" Text="–" Classes="num" Foreground="{DynamicResource BrushTextDim}" />
                      <TextBlock Grid.Column="3" Text="{Binding HeadToHead.QualifyingB}" Classes="num" FontWeight="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,40,14,40">
                      <TextBlock Grid.Column="0" Text="{loc:Tr records.hthRace}" Classes="colHead" />
                      <TextBlock Grid.Column="1" Text="{Binding HeadToHead.RaceA}" Classes="num" FontWeight="Bold" />
                      <TextBlock Grid.Column="2" Text="–" Classes="num" Foreground="{DynamicResource BrushTextDim}" />
                      <TextBlock Grid.Column="3" Text="{Binding HeadToHead.RaceB}" Classes="num" FontWeight="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,40,14,40">
                      <TextBlock Grid.Column="0" Text="{loc:Tr records.hthPoints}" Classes="colHead" />
                      <TextBlock Grid.Column="1" Text="{Binding HeadToHead.PointsA}" Classes="num" FontWeight="Bold"
                                 Foreground="{DynamicResource BrushAccent}" />
                      <TextBlock Grid.Column="2" Text="–" Classes="num" Foreground="{DynamicResource BrushTextDim}" />
                      <TextBlock Grid.Column="3" Text="{Binding HeadToHead.PointsB}" Classes="num" FontWeight="Bold"
                                 Foreground="{DynamicResource BrushAccent}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

            </Grid>

            <Border Grid.Row="1" Classes="card">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrushChrome}"
                        BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,7">
                  <TextBlock Classes="colHead" Text="{loc:Tr records.pointsProgression}" />
                </Border>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="14" HorizontalAlignment="Stretch">
                  <Canvas Width="620" Height="260" Background="Transparent">
                    <Line StartPoint="14,246" EndPoint="606,246"
                          Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" />
                    <Line StartPoint="14,14" EndPoint="14,246"
                          Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" />
                    <ItemsControl ItemsSource="{Binding PointsChart}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="screens:ChartSeriesViewModel">
                          <Path Data="{Binding LineData}" Stroke="{Binding Stroke}" StrokeThickness="2"
                                StrokeLineCap="Round" StrokeJoin="Round" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>
                </Viewbox>
              </DockPanel>
            </Border>

          </Grid>
        </Panel>
      </TabItem>

      <!-- All-time record boards (M24e): the top of each cumulative tally. -->
      <TabItem Header="{loc:Tr records.tabAllTime}">
        <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding AllTimeBoards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="screens:RecordBoardViewModel">
                <Border Classes="card" Margin="0,0,8,8">
                  <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushChrome}"
                            BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="10,7">
                      <TextBlock Text="{Binding Title}" Classes="colHead" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,3,0,5">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="screens:RecordEntryViewModel">
                          <Grid ColumnDefinitions="20,*,Auto" Height="26" Margin="10,0">
                            <TextBlock Grid.Column="0" Text="{Binding Rank}" Classes="num" TextAlignment="Left"
                                       FontSize="11" Foreground="{DynamicResource BrushTextDim}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                              <Border Width="3" Height="13" Background="{Binding Accent}" />
                              <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="num" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <!-- Hall of fame (M24e): the season champions roll + track records; empty until a season completes. -->
      <TabItem Header="{loc:Tr records.tabHallOfFame}">
        <Panel Margin="0,10,0,0">
          <TextBlock Text="{loc:Tr records.emptyHistory}" IsVisible="{Binding !HasHistory}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="12" Foreground="{DynamicResource BrushTextDim}" />

          <Grid IsVisible="{Binding HasHistory}" ColumnDefinitions="1.3*,*">

            <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrushChrome}"
                        BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="14,8">
                  <Grid ColumnDefinitions="56,*,*">
                    <TextBlock Grid.Column="0" Classes="colHead" Text="{loc:Tr records.colYear}" />
                    <TextBlock Grid.Column="1" Classes="colHead" Text="{loc:Tr records.colChampion}" />
                    <TextBlock Grid.Column="2" Classes="colHead" Text="{loc:Tr records.colConstructor}" />
                  </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding HallOfFame}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="screens:SeasonChampionViewModel">
                        <Grid ColumnDefinitions="56,*,*" Height="30" Margin="14,0" Background="Transparent">
                          <TextBlock Grid.Column="0" Text="{Binding Year}" Classes="num" TextAlignment="Left"
                                     FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="3" Height="15" Background="{Binding Accent}" />
                            <TextBlock Text="{Binding DriverChampion}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ConstructorChampion}" FontSize="11"
                                     VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="6,0,0,0">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrushChrome}"
                        BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="14,8">
                  <TextBlock Classes="colHead" Text="{loc:Tr records.trackRecords}" />
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding TrackRecords}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="screens:TrackRecordViewModel">
                        <Grid ColumnDefinitions="*,74,44" Height="32" Margin="14,0" Background="Transparent">
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Circuit}" FontSize="12"
                                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Driver}" FontFamily="{DynamicResource FontNumeric}" FontSize="10"
                                       Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding LapTime}" Classes="num" TextAlignment="Right"
                                     Foreground="{DynamicResource BrushStatusGood}" />
                          <TextBlock Grid.Column="2" Text="{Binding Year}" Classes="num" TextAlignment="Right"
                                     FontSize="11" Foreground="{DynamicResource BrushTextDim}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

          </Grid>
        </Panel>
      </TabItem>

    </TabControl>
  </DockPanel>

</UserControl>
