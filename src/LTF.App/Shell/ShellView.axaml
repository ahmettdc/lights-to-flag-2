<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LTF.App.ViewModels"
             xmlns:shell="using:LTF.App.Shell"
             xmlns:notif="using:LTF.App.Views.Notifications"
             x:Class="LTF.App.Shell.ShellView"
             x:DataType="vm:ShellViewModel">

  <Panel>

    <!-- Permanent chrome: top bar (46) / status bar (26) / sidebar (186) frame the content region. -->
    <DockPanel LastChildFill="True" Background="{DynamicResource BrushAppBackground}">
      <shell:TopBar DockPanel.Dock="Top" DataContext="{Binding TopBar}" />
      <shell:StatusBar DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />
      <shell:Sidebar DockPanel.Dock="Left" DataContext="{Binding Sidebar}" />
      <ContentControl Content="{Binding Navigation.CurrentScreen}" />
    </DockPanel>

    <!-- Inbox popover, anchored under the top-bar INBOX button; toggled from the top bar,
         closed on any navigation. The wrapper Panel carries IsVisible (bound to the shell) and has no
         background, so it stays click-through everywhere except the popover itself — the top bar and
         sidebar behind it remain live. The popover sits inside so its DataContext override doesn't
         collide with the IsVisible binding. -->
    <Panel IsVisible="{Binding IsInboxOpen}">
      <notif:InboxPopover DataContext="{Binding Inbox}"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,52,12,0" />
    </Panel>

  </Panel>

</UserControl>
